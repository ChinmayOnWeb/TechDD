# Tooling state — not project files
.gstack/
.claude/scheduled_tasks.lock

# Python
*.egg-info/
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env

# DD reports on real target companies -- may reference third-party security
# findings (e.g. secrets in their git history); not for public disclosure.
reports/

# Panel-study per-run artifacts.
#
# NOTE the exception below. panel_cache/ was excluded as "regenerable", but it
# is NOT regenerable in this environment: EDGAR and the price vendors are
# blocked by the network policy, so these payloads arrive by hand and the cache
# is the ONLY copy. Excluding them meant every container rollback destroyed
# them. They are public filings, small, and committing them makes the panel
# reproducible by anyone -- which is what the study wants anyway.
panel_cache/*
!panel_cache/edgar_CIK*.json
!panel_cache/stooq_*.csv
!panel_cache/prices_delisted.csv
panel.csv
panel_results/

# Part C cohort working data (regenerable from the frozen frame + seed)
cohort_cache/
cohort_work/
cohort_results/
